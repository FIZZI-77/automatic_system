# Global local-development configuration used by docker-compose.yml.

AUTH_DB_HOST=postgres-auth
AUTH_DB_PORT=5432
AUTH_DB_PUBLISHED_PORT=5432
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=auth_password
AUTH_DB_NAME=auth_db
AUTH_DB_SSLMODE=disable

TICKET_DB_HOST=postgres-ticket
TICKET_DB_PORT=5432
TICKET_DB_PUBLISHED_PORT=5433
TICKET_DB_USERNAME=ticket_user
TICKET_DB_PASSWORD=ticket_password
TICKET_DB_NAME=ticket_db
TICKET_DB_SSLMODE=disable

DEPARTMENT_DB_HOST=postgres-department
DEPARTMENT_DB_PORT=5432
DEPARTMENT_DB_PUBLISHED_PORT=5434
DEPARTMENT_DB_USERNAME=department_user
DEPARTMENT_DB_PASSWORD=department_password
DEPARTMENT_DB_NAME=department_db
DEPARTMENT_DB_SSLMODE=disable

BRIGADE_DB_HOST=postgres-brigade
BRIGADE_DB_PORT=5432
BRIGADE_DB_PUBLISHED_PORT=5435
BRIGADE_DB_USERNAME=brigade_user
BRIGADE_DB_PASSWORD=brigade_password
BRIGADE_DB_NAME=brigade_db
BRIGADE_DB_SSLMODE=disable

PROFILE_DB_HOST=postgres-profile
PROFILE_DB_PORT=5432
PROFILE_DB_PUBLISHED_PORT=5436
PROFILE_DB_USERNAME=profile_user
PROFILE_DB_PASSWORD=profile_password
PROFILE_DB_NAME=profile_db
PROFILE_DB_SSLMODE=disable

KAFKA_BROKERS=kafka:9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_NUM_PARTITIONS=6
OUTBOX_WORKER_COUNT=4
PROFILE_CONSUMER_WORKER_COUNT=4
PROFILE_RETRY_WORKER_COUNT=2
PROFILE_KAFKA_GROUP_ID=brigade-profile-projection-v1

AUTH_GRPC_ADDR=auth-service:50051
TICKET_GRPC_ADDR=ticket-service:50052
DEPARTMENT_GRPC_ADDR=department-service:50053
BRIGADE_GRPC_ADDR=brigade-service:50054
PROFILE_GRPC_ADDR=profile-service:50055

JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_KEY_ID=local-dev-key
JWT_ISSUER=auth-jwt
JWT_AUDIENCE=api-gateway

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@automatic-system.local
SMTP_FROM_NAME=Automatic System
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false
FRONTEND_BASE_URL=http://localhost:3000
