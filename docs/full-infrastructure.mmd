    %% Observability
    subgraph Observability["Observability"]
        OTel["OpenTelemetry SDK / Collector"]
        Prometheus["Prometheus\nmetrics"]
        Grafana["Grafana\ndashboards"]
        Jaeger["Jaeger\ntraces"]
        ELK["ELK / centralized logs"]
        Pprof["Go pprof\nCPU, heap, goroutines"]
        PgStats["pg_stat_statements\nslow SQL"]
    end

    %% Client traffic
    Web --> Traefik
    Mobile --> Traefik
    Admin --> Traefik
    TestTools --> Traefik
    TestTools -. "direct HTTP load" .-> Gateway
    TestTools -. "direct gRPC load with ghz" .-> Auth
    TestTools -. "direct gRPC load with ghz" .-> Department
    TestTools -. "direct gRPC load with ghz" .-> Ticket

    Traefik --> Gateway

    %% Gateway to services
    Gateway -->|gRPC| Auth
    Gateway -->|gRPC| Department
    Gateway -->|gRPC| Ticket
    Gateway -->|gRPC| Brigade
    Gateway -->|gRPC| Dispatch
    Gateway -->|gRPC| Location
    Gateway -->|gRPC| File
    Gateway -->|gRPC| Report

    %% Synchronous service calls
    Ticket -->|validate category / department| Department
    Ticket -->|validate brigade / access| Brigade
    Dispatch -->|ticket data| Ticket
    Dispatch -->|departments / zones| Department
    Dispatch -->|available brigades| Brigade
    Dispatch -->|best route / ETA| Routing
    Routing -->|brigade candidates / specialization| Brigade
    Routing -->|live coordinates| Location
    File -->|resource access check| Ticket
    Report -->|analytics queries| Analytics
    Report -->|save generated report| File
    Notification -. "optional user / department lookup" .-> Auth
    Notification -. "optional ticket context" .-> Ticket

    %% Service ownership
    Auth --> PgAuth
    Department --> PgDepartment
    Department --> PostGIS
    Ticket --> PgTicket
    Brigade --> PgBrigade
    Dispatch --> PgDispatch
    Location --> Redis
    Location --> PostGIS
    Routing --> Redis
    Routing --> PostGIS
    File --> PgFile
    File --> MinIO
    SLA --> PgSLA
    Notification --> PgNotify
    Notification --> Redis
    Report --> PgReport
    Report --> MinIO
    Analytics --> ClickHouse
    Audit --> PgAudit

    %% Outbox writes
    Auth --> OutboxTables
    Department --> OutboxTables
    Ticket --> OutboxTables
    Brigade --> OutboxTables
    Dispatch --> OutboxTables
    File --> OutboxTables
    SLA --> OutboxTables
    Report --> OutboxTables
    OutboxTables --> OutboxRelay
    OutboxRelay --> Kafka

    %% Kafka topics
    Kafka --> AuthTopic
    Kafka --> DepartmentTopic
    Kafka --> TicketTopic
    Kafka --> BrigadeTopic
    Kafka --> DispatchTopic
    Kafka --> LocationTopic
    Kafka --> RoutingTopic
    Kafka --> FileTopic
    Kafka --> SLATopic
    Kafka --> NotificationTopic
    Kafka --> ReportTopic
    Kafka --> RetryTopics
    RetryTopics --> DLQ

    %% Consumers
    TicketTopic --> SLA
    TicketTopic --> Dispatch
    DepartmentTopic --> Dispatch
    BrigadeTopic --> Dispatch
    RoutingTopic --> Dispatch
    LocationTopic --> Routing
    TicketTopic --> Notification
    DepartmentTopic --> Notification
    BrigadeTopic --> Notification
    DispatchTopic --> Notification
    RoutingTopic --> Notification
    FileTopic --> Notification
    SLATopic --> Notification
    AuthTopic --> Analytics
    DepartmentTopic --> Analytics
    TicketTopic --> Analytics
    BrigadeTopic --> Analytics
    DispatchTopic --> Analytics
    LocationTopic --> Analytics
    RoutingTopic --> Analytics
    FileTopic --> Analytics
    SLATopic --> Analytics
    NotificationTopic --> Analytics
    ReportTopic --> Analytics
    AuthTopic --> Audit
    DepartmentTopic --> Audit
    TicketTopic --> Audit
    BrigadeTopic --> Audit
    DispatchTopic --> Audit
    LocationTopic --> Audit
    RoutingTopic --> Audit
    FileTopic --> Audit
    SLATopic --> Audit
    NotificationTopic --> Audit
    ReportTopic --> Audit

    %% Observability flows
    Gateway --> OTel
    Auth --> OTel
    Department --> OTel
    Ticket --> OTel
    Brigade --> OTel
    Dispatch --> OTel
    Location --> OTel
    Routing --> OTel
    File --> OTel
    SLA --> OTel
    Notification --> OTel
    Report --> OTel
    Analytics --> OTel
    Audit --> OTel
