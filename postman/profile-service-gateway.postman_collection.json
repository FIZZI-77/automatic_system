{
  "info": {
    "_postman_id": "8fe7ba36-66e2-4cdc-93b1-profile-gateway-v1",
    "name": "Automatic City Services - Profile Service Gateway",
    "description": "Complete Profile Service HTTP collection through API Gateway. Login first, then run folders from top to bottom. IDs created by responses are saved as collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
  },
  "event": [{
    "listen": "prerequest",
    "script": {
      "type": "text/javascript",
      "exec": [
        "pm.request.headers.upsert({key: 'Content-Type', value: 'application/json'});",
        "pm.request.headers.upsert({key: 'X-Request-ID', value: pm.variables.replaceIn('{{$guid}}')});",
        "pm.request.headers.upsert({key: 'Idempotency-Key', value: pm.variables.replaceIn('{{$guid}}')});",
        "const departmentId = pm.collectionVariables.get('actor_department_id') || pm.collectionVariables.get('department_id');",
        "if (departmentId) pm.request.headers.upsert({key: 'X-Actor-Department-ID', value: departmentId});"
      ]
    }
  }],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8081"},
    {"key": "test_email", "value": "demo.admin@city.local"},
    {"key": "test_password", "value": "CityDemo123!"},
    {"key": "access_token", "value": ""},
    {"key": "refresh_token", "value": ""},
    {"key": "user_id", "value": "c6d1270f-0496-4411-b557-9b7b3f513f1e"},
    {"key": "user_profile_id", "value": "50000000-0000-4000-8000-000000000004"},
    {"key": "work_profile_id", "value": "51000000-0000-4000-8000-000000000004"},
    {"key": "department_id", "value": "10000000-0000-4000-8000-000000000001"},
    {"key": "department_idempotency_key", "value": "6e422977-945f-4b70-a76f-f11ee239cf40"},
    {"key": "new_department_id", "value": "10000000-0000-4000-8000-000000000002"},
    {"key": "actor_department_id", "value": ""},
    {"key": "skill_id", "value": "40000000-0000-4000-8000-000000000001"},
    {"key": "second_skill_id", "value": ""},
    {"key": "certification_type_id", "value": "52000000-0000-4000-8000-000000000001"},
    {"key": "certification_id", "value": ""},
    {"key": "rejection_certification_id", "value": "e68c516c-331d-484f-bbb3-9dd36ea929aa"},
    {"key": "skill_grant_id", "value": ""},
    {"key": "avatar_file_id", "value": ""},
    {"key": "certificate_file_id", "value": ""}
  ],
  "item": [
    {
      "name": "00 Setup",
      "item": [
        {
          "name": "Health",
          "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{base_url}}/health"}
        },
        {
          "name": "Login",
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"client_id\": \"postman-profile-gateway\"\n}"},
            "url": "{{base_url}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('login succeeded', () => pm.expect(pm.response.code).to.eql(200));",
                "const json = pm.response.json();",
                "if (json.access_token) pm.collectionVariables.set('access_token', json.access_token);",
                "if (json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);",
                "const userId = json.user_id || (json.user && (json.user.id || json.user.user_id));",
                "if (userId) pm.collectionVariables.set('user_id', userId);"
              ]
            }
          }]
        },
        {
          "name": "Current auth user",
          "request": {"method": "GET", "url": "{{base_url}}/auth/me"},
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('authorized', () => pm.expect(pm.response.code).to.eql(200));",
                "const json = pm.response.json();",
                "const userId = json.user_id || (json.user && (json.user.id || json.user.user_id));",
                "if (userId) pm.collectionVariables.set('user_id', userId);"
              ]
            }
          }]
        },
        {
          "name": "Load current user profile",
          "request": {"method": "GET", "url": "{{base_url}}/user-profiles/me"},
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('current user profile loaded', () => pm.expect(pm.response.code).to.eql(200));",
                "const json = pm.response.json();",
                "if (json.user_profile && json.user_profile.id) pm.collectionVariables.set('user_profile_id', json.user_profile.id);"
              ]
            }
          }]
        },
        {
          "name": "Create department for profile tests",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Idempotency-Key", "value": "{{department_idempotency_key}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Profile Department\",\n  \"description\": \"Department used by Profile Service Gateway collection\"\n}"
            },
            "url": "{{base_url}}/departments/create"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('department available', () => pm.expect([200, 201]).to.include(pm.response.code));",
                "const json = pm.response.json();",
                "if (json.department && json.department.id) pm.collectionVariables.set('department_id', json.department.id);"
              ]
            }
          }]
        },
        {
          "name": "Load test skill",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true,\n  \"query\": \"Postman Profile Skill\",\n  \"limit\": 10,\n  \"offset\": 0\n}"
            },
            "url": "{{base_url}}/skills/list"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('test skill loaded', () => pm.expect(pm.response.code).to.eql(200));",
                "const json = pm.response.json();",
                "if (json.skills && json.skills.length) pm.collectionVariables.set('skill_id', json.skills[0].id);"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "10 User Profiles",
      "item": [
        {
          "name": "Create user profile",
          "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"full_name\": \"Postman Test User\",\n  \"phone\": \"+79990000000\",\n  \"preferred_contact_method\": \"email\"\n}"}, "url": "{{base_url}}/user-profiles/create"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('profile created or already exists', () => pm.expect([200, 201, 409]).to.include(pm.response.code));", "const json = pm.response.json();", "if (json.user_profile && json.user_profile.id) pm.collectionVariables.set('user_profile_id', json.user_profile.id);"]}}]
        },
        {"name": "Get user profile by id", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{user_profile_id}}\"\n}"}, "url": "{{base_url}}/user-profiles/get"}},
        {"name": "Get user profile by user id", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"user_id\": \"{{user_id}}\"\n}"}, "url": "{{base_url}}/user-profiles/get-by-user"}},
        {
          "name": "Get my user profile",
          "request": {"method": "GET", "url": "{{base_url}}/user-profiles/me"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.user_profile && json.user_profile.id) pm.collectionVariables.set('user_profile_id', json.user_profile.id);"]}}]
        },
        {"name": "List user profiles", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"query\": \"Postman\",\n  \"sort_by\": \"created_at\",\n  \"sort_order\": \"desc\",\n  \"limit\": 20,\n  \"offset\": 0\n}"}, "url": "{{base_url}}/user-profiles/list"}},
        {"name": "Update user profile", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{user_profile_id}}\",\n  \"full_name\": \"Postman Test User Updated\",\n  \"phone\": \"+79990000001\",\n  \"clear_phone\": false,\n  \"preferred_contact_method\": \"phone\"\n}"}, "url": "{{base_url}}/user-profiles/update"}}
      ]
    },
    {
      "name": "20 Work Profiles",
      "item": [
        {
          "name": "Create work profile",
          "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"user_profile_id\": \"{{user_profile_id}}\",\n  \"department_id\": \"{{department_id}}\",\n  \"employee_number\": \"POSTMAN-001\",\n  \"position\": \"Field Engineer\"\n}"}, "url": "{{base_url}}/work-profiles/create"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('work profile created or already exists', () => pm.expect([200, 201, 409]).to.include(pm.response.code));", "const json = pm.response.json();", "const id = json.details && (json.details.id || (json.details.work_profile && json.details.work_profile.id));", "if (id) pm.collectionVariables.set('work_profile_id', id);"]}}]
        },
        {"name": "Get work profile by id", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{work_profile_id}}\"\n}"}, "url": "{{base_url}}/work-profiles/get"}},
        {"name": "Get work profile by user id", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"user_id\": \"{{user_id}}\"\n}"}, "url": "{{base_url}}/work-profiles/get-by-user"}},
        {"name": "List work profiles", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"department_id\": \"{{department_id}}\",\n  \"status\": \"active\",\n  \"sort_by\": \"created_at\",\n  \"sort_order\": \"desc\",\n  \"limit\": 20,\n  \"offset\": 0\n}"}, "url": "{{base_url}}/work-profiles/list"}},
        {"name": "Update work profile", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{work_profile_id}}\",\n  \"employee_number\": \"POSTMAN-002\",\n  \"clear_employee_number\": false,\n  \"position\": \"Senior Field Engineer\"\n}"}, "url": "{{base_url}}/work-profiles/update"}},
        {"name": "Change work profile department", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{work_profile_id}}\",\n  \"department_id\": \"{{new_department_id}}\",\n  \"reason\": \"Postman integration test\"\n}"}, "url": "{{base_url}}/work-profiles/change-department"}},
        {"name": "Set work profile status on shift", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{work_profile_id}}\",\n  \"status\": \"on_shift\",\n  \"reason\": \"Postman integration test\"\n}"}, "url": "{{base_url}}/work-profiles/set-status"}},
        {"name": "Work profile status history", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"work_profile_id\": \"{{work_profile_id}}\",\n  \"limit\": 50,\n  \"offset\": 0\n}"}, "url": "{{base_url}}/work-profiles/status-history"}}
      ]
    },
    {
      "name": "30 Profile Checks",
      "item": [
        {"name": "Resolve working department", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"user_id\": \"{{user_id}}\"\n}"}, "url": "{{base_url}}/profile-checks/resolve-working-department"}},
        {"name": "Can join brigade by user id", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"brigade_department_id\": \"{{department_id}}\"\n}"}, "url": "{{base_url}}/profile-checks/can-join-brigade"}},
        {"name": "Can join brigade by work profile id", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"work_profile_id\": \"{{work_profile_id}}\",\n  \"brigade_department_id\": \"{{department_id}}\"\n}"}, "url": "{{base_url}}/profile-checks/can-join-brigade"}}
      ]
    },
    {
      "name": "40 Certification Types",
      "item": [
        {
          "name": "Create certification type",
          "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"code\": \"POSTMAN-{{$guid}}\",\n  \"name\": \"Postman Electrical Safety\",\n  \"description\": \"Created from Postman\",\n  \"default_validity_days\": 365,\n  \"requires_file\": false\n}"}, "url": "{{base_url}}/certification-types/create"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('certification type created', () => pm.expect([200, 201]).to.include(pm.response.code));", "const json = pm.response.json();", "if (json.certification_type && json.certification_type.id) pm.collectionVariables.set('certification_type_id', json.certification_type.id);"]}}]
        },
        {"name": "Update certification type", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{certification_type_id}}\",\n  \"name\": \"Postman Electrical Safety Updated\",\n  \"description\": \"Updated from Postman\",\n  \"requires_file\": false,\n  \"active\": true\n}"}, "url": "{{base_url}}/certification-types/update"}},
        {"name": "List certification types", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"active\": true,\n  \"query\": \"Postman\",\n  \"limit\": 20,\n  \"offset\": 0\n}"}, "url": "{{base_url}}/certification-types/list"}},
        {"name": "Add certification type skill", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"certification_type_id\": \"{{certification_type_id}}\",\n  \"skill_id\": \"{{skill_id}}\",\n  \"proficiency_level\": \"advanced\"\n}"}, "url": "{{base_url}}/certification-type-skills/add"}},
        {"name": "List certification type skills", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"certification_type_id\": \"{{certification_type_id}}\",\n  \"active_only\": true\n}"}, "url": "{{base_url}}/certification-type-skills/list"}},
        {"name": "Remove certification type skill (run after certification tests)", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"certification_type_id\": \"{{certification_type_id}}\",\n  \"skill_id\": \"{{skill_id}}\"\n}"}, "url": "{{base_url}}/certification-type-skills/remove"}}
      ]
    },
    {
      "name": "50 Work Profile Certifications",
      "item": [
        {
          "name": "Upload certification",
          "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"work_profile_id\": \"{{work_profile_id}}\",\n  \"certification_type_id\": \"{{certification_type_id}}\",\n  \"certificate_number\": \"POSTMAN-CERT-{{$guid}}\",\n  \"issuer\": \"Postman Training Center\",\n  \"issued_at\": \"2026-01-01T10:00:00Z\",\n  \"expires_at\": \"2027-01-01T10:00:00Z\"\n}"}, "url": "{{base_url}}/work-profile-certifications/upload"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('certification uploaded', () => pm.expect([200, 201]).to.include(pm.response.code));", "const json = pm.response.json();", "if (json.certification && json.certification.id) pm.collectionVariables.set('certification_id', json.certification.id);"]}}]
        },
        {
          "name": "Verify certification",
          "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{certification_id}}\"\n}"}, "url": "{{base_url}}/work-profile-certifications/verify"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.skill_grants && json.skill_grants[0]) pm.collectionVariables.set('skill_grant_id', json.skill_grants[0].id);"]}}]
        },
        {
          "name": "Upload certification for rejection",
          "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"work_profile_id\": \"{{work_profile_id}}\",\n  \"certification_type_id\": \"{{certification_type_id}}\",\n  \"certificate_number\": \"POSTMAN-CERT-REJECT-{{$guid}}\",\n  \"issuer\": \"Postman Training Center\",\n  \"issued_at\": \"2026-01-02T10:00:00Z\",\n  \"expires_at\": \"2027-01-02T10:00:00Z\"\n}"}, "url": "{{base_url}}/work-profile-certifications/upload"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('pending certification uploaded', () => pm.expect([200, 201]).to.include(pm.response.code));", "const json = pm.response.json();", "if (json.certification && json.certification.id) pm.collectionVariables.set('rejection_certification_id', json.certification.id);"]}}]
        },
        {"name": "Reject pending certification", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{rejection_certification_id}}\",\n  \"rejection_reason\": \"Invalid document\"\n}"}, "url": "{{base_url}}/work-profile-certifications/reject"}},
        {"name": "Revoke certification", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{certification_id}}\",\n  \"reason\": \"Postman integration test\"\n}"}, "url": "{{base_url}}/work-profile-certifications/revoke"}},
        {"name": "Expire due certifications", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"limit\": 100\n}"}, "url": "{{base_url}}/work-profile-certifications/expire"}},
        {"name": "List work profile certifications", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"work_profile_id\": \"{{work_profile_id}}\",\n  \"limit\": 50,\n  \"offset\": 0\n}"}, "url": "{{base_url}}/work-profile-certifications/list"}}
      ]
    },
    {
      "name": "60 Effective Skills",
      "item": [
        {
          "name": "Grant manual skill",
          "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"work_profile_id\": \"{{work_profile_id}}\",\n  \"skill_id\": \"{{skill_id}}\",\n  \"proficiency_level\": \"advanced\",\n  \"valid_until\": \"2027-12-31T23:59:59Z\",\n  \"reason\": \"Postman integration test\"\n}"}, "url": "{{base_url}}/work-profile-skills/grant-manual"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('skill granted', () => pm.expect([200, 201]).to.include(pm.response.code));", "const json = pm.response.json();", "if (json.skill_grant && json.skill_grant.id) pm.collectionVariables.set('skill_grant_id', json.skill_grant.id);"]}}]
        },
        {"name": "List effective skills", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"work_profile_id\": \"{{work_profile_id}}\"\n}"}, "url": "{{base_url}}/work-profile-skills/list-effective"}},
        {"name": "Batch list effective skills", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"work_profile_ids\": [\"{{work_profile_id}}\"]\n}"}, "url": "{{base_url}}/work-profile-skills/batch-list-effective"}},
        {"name": "Check work profile has skills", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"work_profile_id\": \"{{work_profile_id}}\",\n  \"required_skill_ids\": [\"{{skill_id}}\"]\n}"}, "url": "{{base_url}}/work-profile-skills/has-skills"}},
        {"name": "Revoke skill grant", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{skill_grant_id}}\",\n  \"reason\": \"Postman cleanup\"\n}"}, "url": "{{base_url}}/work-profile-skills/revoke"}}
      ]
    },
    {
      "name": "90 Cleanup",
      "item": [
        {"name": "Deactivate work profile (destructive, run last)", "request": {"method": "POST", "body": {"mode": "raw", "raw": "{\n  \"id\": \"{{work_profile_id}}\",\n  \"reason\": \"Postman cleanup\"\n}"}, "url": "{{base_url}}/work-profiles/deactivate"}}
      ]
    }
  ]
}
