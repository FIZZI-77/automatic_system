              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{department_idempotency_key}}-update"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{department_id}}\",\n  \"name\": \"Utilities Department Updated {{$guid}}\",\n  \"description\": \"Updated department description\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{base_url}}/departments/update"
          },
          "event": [
            {
              "listen": "test",
