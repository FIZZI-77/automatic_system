# runtime.env.example
#
# Template for Kubernetes Secret/runtime-secrets.
# Do NOT commit a filled runtime.env with real credentials.
#
# CI/CD flow:
#   runtime.env -> base64 -> GitHub Environment secret RUNTIME_ENV_B64
#   workflow decodes it and creates Kubernetes Secret/runtime-secrets.
#
# Keep DB_PASSWORD, DATABASE_URL and GOOSE_DBSTRING values for each database
# consistent with each other.
#
# Applications use PgBouncer on port 6432. Goose migrations and administrative
# jobs connect directly to the Patroni services on port 5432.

PLATFORM_POSTGRES_SUPERUSER_PASSWORD=change-me-platform-superuser-password
PLATFORM_POSTGRES_REPLICATION_PASSWORD=change-me-platform-replication-password
TICKET_POSTGRES_SUPERUSER_PASSWORD=change-me-ticket-superuser-password
TICKET_POSTGRES_REPLICATION_PASSWORD=change-me-ticket-replication-password

# =============================================================================
# PostgreSQL: Auth
# =============================================================================
AUTH_DB_PASSWORD=change-me-auth-db-password
AUTH_GOOSE_DBSTRING=postgres://auth_user:change-me-auth-db-password@postgres-platform-primary:5432/auth_db?sslmode=disable

# =============================================================================
# PostgreSQL: Ticket
# =============================================================================
TICKET_DB_PASSWORD=change-me-ticket-db-password
TICKET_GOOSE_DBSTRING=postgres://ticket_user:change-me-ticket-db-password@postgres-ticket-primary:5432/ticket_db?sslmode=disable

# =============================================================================
# PostgreSQL: Department
# =============================================================================
DEPARTMENT_DB_PASSWORD=change-me-department-db-password
DEPARTMENT_GOOSE_DBSTRING=postgres://department_user:change-me-department-db-password@postgres-platform-primary:5432/department_db?sslmode=disable

# =============================================================================
# PostgreSQL: Brigade
# =============================================================================
BRIGADE_DB_PASSWORD=change-me-brigade-db-password
BRIGADE_GOOSE_DBSTRING=postgres://brigade_user:change-me-brigade-db-password@postgres-platform-primary:5432/brigade_db?sslmode=disable

# =============================================================================
# PostgreSQL: Profile
# =============================================================================
PROFILE_DB_PASSWORD=change-me-profile-db-password
PROFILE_GOOSE_DBSTRING=postgres://profile_user:change-me-profile-db-password@postgres-platform-primary:5432/profile_db?sslmode=disable

# =============================================================================
# PostgreSQL: Location
# =============================================================================
LOCATION_DB_PASSWORD=change-me-location-db-password
LOCATION_DATABASE_URL=postgres://location:change-me-location-db-password@pgbouncer-platform-primary:6432/location?sslmode=disable
LOCATION_READ_DATABASE_URL=postgres://location:change-me-location-db-password@pgbouncer-platform-replicas:6432/location?sslmode=disable
LOCATION_GOOSE_DBSTRING=postgres://location:change-me-location-db-password@postgres-platform-primary:5432/location?sslmode=disable

# =============================================================================
# PostgreSQL: Routing
# =============================================================================
ROUTING_DB_PASSWORD=change-me-routing-db-password
ROUTING_DATABASE_URL=postgres://routing:change-me-routing-db-password@pgbouncer-platform-primary:6432/routing?sslmode=disable
ROUTING_READ_DATABASE_URL=postgres://routing:change-me-routing-db-password@pgbouncer-platform-replicas:6432/routing?sslmode=disable
ROUTING_GOOSE_DBSTRING=postgres://routing:change-me-routing-db-password@postgres-platform-primary:5432/routing?sslmode=disable

# =============================================================================
# PostgreSQL: Dispatch
# =============================================================================
DISPATCH_DB_PASSWORD=change-me-dispatch-db-password
DISPATCH_DATABASE_URL=postgres://dispatch:change-me-dispatch-db-password@pgbouncer-platform-primary:6432/dispatch?sslmode=disable
DISPATCH_READ_DATABASE_URL=postgres://dispatch:change-me-dispatch-db-password@pgbouncer-platform-replicas:6432/dispatch?sslmode=disable
DISPATCH_GOOSE_DBSTRING=postgres://dispatch:change-me-dispatch-db-password@postgres-platform-primary:5432/dispatch?sslmode=disable

# =============================================================================
# PostgreSQL: File
# =============================================================================
FILE_DB_PASSWORD=change-me-file-db-password
FILE_DATABASE_URL=postgres://file:change-me-file-db-password@pgbouncer-platform-primary:6432/file?sslmode=disable
FILE_READ_DATABASE_URL=postgres://file:change-me-file-db-password@pgbouncer-platform-replicas:6432/file?sslmode=disable
FILE_GOOSE_DBSTRING=postgres://file:change-me-file-db-password@postgres-platform-primary:5432/file?sslmode=disable

# =============================================================================
# PostgreSQL: SLA
# =============================================================================
SLA_DB_PASSWORD=change-me-sla-db-password
SLA_DATABASE_URL=postgres://sla:change-me-sla-db-password@pgbouncer-platform-primary:6432/sla?sslmode=disable
SLA_READ_DATABASE_URL=postgres://sla:change-me-sla-db-password@pgbouncer-platform-replicas:6432/sla?sslmode=disable
SLA_GOOSE_DBSTRING=postgres://sla:change-me-sla-db-password@postgres-platform-primary:5432/sla?sslmode=disable

# =============================================================================
# PostgreSQL: Notification
# =============================================================================
NOTIFICATION_DB_PASSWORD=change-me-notification-db-password
NOTIFICATION_DATABASE_URL=postgres://notification:change-me-notification-db-password@pgbouncer-platform-primary:6432/notification?sslmode=disable
NOTIFICATION_READ_DATABASE_URL=postgres://notification:change-me-notification-db-password@pgbouncer-platform-replicas:6432/notification?sslmode=disable
NOTIFICATION_GOOSE_DBSTRING=postgres://notification:change-me-notification-db-password@postgres-platform-primary:5432/notification?sslmode=disable

# =============================================================================
# PostgreSQL: Audit
# =============================================================================
AUDIT_DB_PASSWORD=change-me-audit-db-password
AUDIT_DATABASE_URL=postgres://audit:change-me-audit-db-password@pgbouncer-platform-primary:6432/audit?sslmode=disable
AUDIT_READ_DATABASE_URL=postgres://audit:change-me-audit-db-password@pgbouncer-platform-replicas:6432/audit?sslmode=disable
AUDIT_GOOSE_DBSTRING=postgres://audit:change-me-audit-db-password@postgres-platform-primary:5432/audit?sslmode=disable

# =============================================================================
# PostgreSQL: Report
# =============================================================================
REPORT_DB_PASSWORD=change-me-report-db-password
REPORT_DATABASE_URL=postgres://report:change-me-report-db-password@pgbouncer-platform-primary:6432/report?sslmode=disable
REPORT_READ_DATABASE_URL=postgres://report:change-me-report-db-password@pgbouncer-platform-replicas:6432/report?sslmode=disable
REPORT_GOOSE_DBSTRING=postgres://report:change-me-report-db-password@postgres-platform-primary:5432/report?sslmode=disable

# =============================================================================
# PostgreSQL/PostGIS: Asset
# =============================================================================
ASSET_DB_PASSWORD=change-me-asset-db-password
ASSET_DATABASE_URL=postgres://asset:change-me-asset-db-password@pgbouncer-platform-primary:6432/asset?sslmode=disable
ASSET_READ_DATABASE_URL=postgres://asset:change-me-asset-db-password@pgbouncer-platform-replicas:6432/asset?sslmode=disable
ASSET_GOOSE_DBSTRING=postgres://asset:change-me-asset-db-password@postgres-platform-primary:5432/asset?sslmode=disable

# =============================================================================
# Redis
# =============================================================================
# REDIS_PASSWORD is currently optional in some workloads, but define it if
# password authentication is enabled.
REDIS_PASSWORD=change-me-redis-password
REDIS_SENTINEL_PASSWORD=change-me-redis-sentinel-password

# =============================================================================
# MinIO / S3
# =============================================================================
# File Service uses S3_ACCESS_KEY / S3_SECRET_KEY.
# MinIO itself uses MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
# For the current local-style setup they may intentionally be the same
# credentials, but keep the variable names separate.
MINIO_ROOT_USER=automatic-system
MINIO_ROOT_PASSWORD=change-me-minio-root-password
S3_ACCESS_KEY=automatic-system
S3_SECRET_KEY=change-me-minio-s3-secret-key

# =============================================================================
# ClickHouse
# =============================================================================
CLICKHOUSE_PASSWORD=change-me-clickhouse-password

# =============================================================================
# Auth / SMTP
# =============================================================================
SMTP_PASSWORD=change-me-smtp-password

# =============================================================================
# API Gateway / Report Service
# =============================================================================
REPORT_INTERNAL_TOKEN=change-me-long-random-report-internal-token

# =============================================================================
# Location / Transponder
# =============================================================================
TRANSPONDER_API_KEY=change-me-transponder-api-key
